# Copy this file to backend/.env and fill in real values. backend/.env is gitignored.
#
# This file holds every secret and config value the Go backend AND
# docker-compose.yml need. The frontend has its own separate .env.example
# in frontend/brew-ops/ with only VITE_API_BASE_URL — this is intentional,
# not a duplication oversight: any variable in a Vite .env file gets
# bundled into the public JavaScript shipped to the browser, so secrets
# like JWT_SECRET or OPENAI_API_KEY must never live anywhere Vite can see
# them. Never merge these two files back together.

# --- Backend server ---
# Port the Fiber HTTP server listens on.
PORT=8080
# "development" or "production". Defaults to "production" (fail closed) if
# unset. Must be "development" for POST /api/v1/auth/register to respond —
# it 404s otherwise. Set to "development" for local work.
APP_ENV=development
# Comma-separated list of origins allowed by CORS (the Vite dev server by default).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database (Postgres via Supabase in production, docker-compose locally) ---
# Full connection string used by the Go backend (pgx).
DATABASE_URL=postgres://brewops:brewops@localhost:5432/brewops?sslmode=disable
# Consumed directly by docker-compose.yml (via env_file) to provision the
# local Postgres container — named POSTGRES_* to match exactly what the
# official postgres image reads, so no docker-compose.yml substitution is
# needed for these. The container's host port is hardcoded in
# docker-compose.yml instead of driven by an env var — see its comment for
# why — so keep it in sync by hand with the port embedded in DATABASE_URL
# above if you ever change either one.
POSTGRES_USER=brewops
POSTGRES_PASSWORD=brewops
POSTGRES_DB=brewops

# --- Auth (manual JWT, golang-jwt/jwt/v5) ---
# Secret used to sign and verify JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret
# How long an access token stays valid (Go duration syntax). 8h = one work
# shift — see the "JWT token lifetimes" note in CLAUDE.md's tech stack table.
JWT_ACCESS_TOKEN_TTL=8h
# How long a refresh token stays valid (Go duration syntax). 720h = 30 days.
JWT_REFRESH_TOKEN_TTL=720h

# --- AI feature (POST /api/v1/inventory/suggest) ---
# OpenAI API key used to call gpt-4o-mini for natural-language inventory parsing.
OPENAI_API_KEY=

# --- GCP Cloud Storage (product/marketing images) ---
# GCP project that owns the Cloud Storage bucket and Cloud Run service.
GCP_PROJECT_ID=
# Bucket name where product and marketing images are uploaded.
GCP_STORAGE_BUCKET=
# Path to a service account JSON key file, for local development only
# (Cloud Run uses its attached service account instead).
GOOGLE_APPLICATION_CREDENTIALS=

# --- Image storage backend (storage.StorageClient) ---
# "local" (default): saves to ./local-storage/ and serves it via a Fiber
# static route, no GCP account needed — use this until GCP billing is set
# up. "gcs": uploads to the real GCP_STORAGE_BUCKET above.
STORAGE_BACKEND=local
# Base URL LocalDiskStorageClient prefixes onto filenames to build a
# fetchable URL (mirrors GCS's fully-qualified URLs). Unused when
# STORAGE_BACKEND=gcs.
PUBLIC_BASE_URL=http://localhost:8080
