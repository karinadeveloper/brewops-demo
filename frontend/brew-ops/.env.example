# Copy this file to frontend/brew-ops/.env and fill in real values.
# frontend/brew-ops/.env is gitignored.
#
# This file is intentionally separate from backend/.env.example: any
# variable in a Vite .env file gets bundled into the public JavaScript
# shipped to the browser. Backend secrets (JWT_SECRET, OPENAI_API_KEY,
# database credentials, etc.) must never live here — see
# backend/.env.example for those.

# Base URL the frontend's useApi composable prefixes onto every request.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Demo mode (this repo only — see CLAUDE.md's "DEMO MODE" section). "true"
# shows the demo credentials banner on the login page and a small "this is
# a public demo" notice across the app. Defaults to off (any other value,
# including unset).
VITE_DEMO_MODE=false
